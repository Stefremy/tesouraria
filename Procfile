# Heroku Procfile for Tesouraria
# This file tells Heroku how to run the application

# For Python applications
web: python main.py
# Alternative for Django
# web: gunicorn myproject.wsgi --log-file -
# Alternative for Flask
# web: gunicorn app:app

# For Node.js applications
# web: node server.js
# Alternative with npm
# web: npm start

# Using the start script (works for both Python and Node.js)
# web: ./start.sh
